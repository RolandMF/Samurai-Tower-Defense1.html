// CATATAN: newGen = bikin Jenderal baru di awal permainan (Lv 1, berdiri di jalur pertama).
function newGen(){const[x0,y0]=at(90,0);return{type:'g',pi:0,d:90,tpi:0,td:90,via:null,lv:1,spent:0,cd:0,sw:0,stun:0,ang:0,x:x0,y:y0}}
// CATATAN: genTarget = perintah "jalan ke titik ini". Kalau tujuan ada di jalur lain, Jenderal lewat persimpangan dulu. Hasil false = tidak ada jalan ke sana.
function genTarget(pi,d){const G=g.gen;let best=null,bc=1e9;G.tpi=pi;G.td=d;G.via=null;
  if(pi===G.pi)return true;
  for(const L of MP.links)if(L.a===G.pi&&L.b===pi){const c=Math.abs(G.d-L.da)+Math.abs(d-L.db);if(c<bc){bc=c;best=L}}
  if(!best){G.tpi=G.pi;G.td=G.d;return false}
  G.via=best;return true}
// CATATAN: segDir = arah jalan (vektor panjang 1) pada titik d di jalur pi.
function segDir(pi,d){const p=MP.paths[pi];let i=0;while(i<p.seg.length-1&&d>p.seg[i][0]+p.seg[i][1])i++;const a=p.P[i],b=p.P[i+1],l=p.seg[i][1];return[(b[0]-a[0])/l,(b[1]-a[1])/l]}
const keys={};   // tombol yang sedang ditekan
// CATATAN: genKeys = gerakkan Jenderal pakai keyboard (panah / WASD). Jenderal ikut belok mengikuti jalan. Hasil true = ada tombol arah ditekan.
function genKeys(G,sp){
  const kx=(keys.ArrowRight||keys.KeyD?1:0)-(keys.ArrowLeft||keys.KeyA?1:0),ky=(keys.ArrowDown||keys.KeyS?1:0)-(keys.ArrowUp||keys.KeyW?1:0);
  if(!kx&&!ky)return false;
  const n=Math.hypot(kx,ky),cand=[[G.pi,G.d]];   // kandidat: jalur sekarang + jalur lain kalau lagi di persimpangan
  for(const L of MP.links)if(L.a===G.pi&&Math.abs(L.da-G.d)<=sp+1)cand.push([L.b,L.db]);
  let best=null,bs=.5;
  for(const[pi,d]of cand)for(const sg of[1,-1]){const v=segDir(pi,d+.01*sg),dot=(v[0]*sg*kx+v[1]*sg*ky)/n;if(dot>bs){bs=dot;best={pi,d,sg}}}
  if(best)G.pi=best.pi,G.d=Math.max(0,Math.min(MP.paths[best.pi].tot,best.d+best.sg*sp));
  G.tpi=G.pi;G.td=G.d;G.via=null;return true}
// CATATAN: catat tombol yang ditekan / dilepas.
addEventListener('keydown',e=>{keys[e.code]=true;if(!$('gm').hidden&&e.code.startsWith('Arrow'))e.preventDefault()});
addEventListener('keyup',e=>{keys[e.code]=false});
addEventListener('blur',()=>{for(const k in keys)keys[k]=false});
// CATATAN: updateGen = dipanggil tiap frame: Jenderal jalan (klik / keyboard), lalu menebas zombie yang ada dalam jangkauannya.
function updateGen(){
  const G=g.gen,sp=S(G).spd[G.lv],ox=G.x,oy=G.y;
  if(!genKeys(G,sp)){   // tidak pakai keyboard: ikuti perintah klik
    const want=G.via?G.via.da:G.td,dd=want-G.d;
    if(Math.abs(dd)<=sp){G.d=want;if(G.via){G.pi=G.via.b;G.d=G.via.db;G.via=null}}else G.d+=Math.sign(dd)*sp}
  [G.x,G.y]=at(G.d,G.pi);
  if(G.cd>0)G.cd--;if(G.sw>0)G.sw--;
  if(G.sw<=0&&Math.hypot(G.x-ox,G.y-oy)>.05)G.ang=Math.atan2(G.y-oy,G.x-ox);
  if(G.stun>0){G.stun--;return}
  if(G.cd>0)return;
  const R=S(G).range[G.lv],L=g.z.filter(z=>{if(z.hp<=0||(z.hid&&!z.vis))return false;const[zx,zy]=at(z.d,z.pi);return Math.hypot(zx-G.x,zy-G.y)<=R}).sort((a,b)=>prog(b)-prog(a)).slice(0,S(G).hits[G.lv]);
  if(!L.length)return;
  const[tx,ty]=at(L[0].d,L[0].pi);G.ang=Math.atan2(ty-G.y,tx-G.x);G.cd=S(G).rate[G.lv];G.sw=9;
  for(const z of L)dmgZ(z,S(G).dmg[G.lv]);snd('slash',G.lv)}
// CATATAN: gInfo = teks info Jenderal di bagian bawah layar.
function gInfo(s){return S(s).name[s.lv]+' • Lv '+s.lv+' • Damage '+S(s).dmg[s.lv]+' • Jarak '+S(s).range[s.lv]+' • Tebas '+S(s).hits[s.lv]+' musuh • Kecepatan '+S(s).spd[s.lv]}
// CATATAN: drawGeneral = gambar Jenderal (jubah merah, lingkaran biru, pedang + topeng ala Shogun, panji) dan penanda tujuan jalannya.
function drawGeneral(){
  const G=g.gen,[X,Y]=at(G.d,G.pi),l=G.lv;
  if(g.sel===G){x.fillStyle='rgba(255,255,255,.12)';x.beginPath();x.arc(X,Y,S(G).range[l],0,7);x.fill();x.strokeStyle='#fff8';x.lineWidth=1.5;x.stroke()}
  if(G.pi!==G.tpi||Math.abs(G.d-G.td)>1){const[tx,ty]=at(G.td,G.tpi);x.strokeStyle='rgba(255,213,79,.85)';x.lineWidth=2;x.setLineDash([4,3]);x.beginPath();x.arc(tx,ty,9+Math.sin(Date.now()/150)*2,0,7);x.stroke();x.setLineDash([])}
  x.fillStyle='#c0392b';x.beginPath();x.moveTo(X-12,Y-2);x.lineTo(X-22,Y+16);x.lineTo(X+2,Y+12);x.fill();
  x.fillStyle=['','#2f5d8a','#2f7d8a','#6a2f8a','#b8860b'][l];x.beginPath();x.arc(X,Y,16,0,7);x.fill();x.strokeStyle='#ffd54f';x.lineWidth=2.5;x.stroke();
  drawKatana({x:X,y:Y,lv:l,ang:G.ang,sw:G.sw});
  x.fillStyle='#1565c0';x.fillRect(X+14,Y-34,2,36);x.fillRect(X+16,Y-34,14,10);x.fillStyle='#fff';x.font='bold 9px system-ui,sans-serif';x.textAlign='center';x.fillText('★',X+23,Y-26);
  if(G.stun>0){x.fillStyle='rgba(255,235,59,.35)';x.beginPath();x.arc(X,Y,20,0,7);x.fill();x.fillStyle='#fff176';x.font='bold 14px system-ui,sans-serif';x.fillText('⚡',X,Y-22)}
}
function update(){
  if(g.running&&g.q+g.bs.length>0&&--g.sp<=0){
    g.sp=Math.max(30,60-g.wave*2);
    if(g.bs.length&&g.q<=1){const M=g.bs.shift()==='M',hp=M?700:220;g.z.push({d:0,pi:nextPath(),hp,max:hp,sp:M?.5:.6,boss:1,mega:M,hit:0,r:M?30:20,col:M?'#4a0f12':'#6a2c7a',rew:M?250:90,cost:M?6:3})}
    else{g.q--;const dm=g.dm,H=5,b=.7,r=Math.random(),ro=dm.roster,w=g.wave,K=1+w/25;let z;
      if(ro.includes('x')&&w>=8&&Math.random()<.07*K)z={hp:Math.ceil(H*1.4),sp:b*.9,r:14,col:'#c0392b',k:'x',rew:12,cost:1};
      else if(ro.includes('m')&&w>=10&&Math.random()<.06*K)z={hp:Math.ceil(H*1.1),sp:b*.8,r:12,col:'#27ae60',k:'m',rew:14,cost:1};
      else if(ro.includes('a')&&w>=6&&Math.random()<.12*K)z={hp:Math.ceil(H*1.6),sp:b*.85,r:13,col:'#7f8c8d',k:'a',rew:12,cost:1};
      else if(ro.includes('r')&&w>=7&&Math.random()<.1*K)z={hp:Math.ceil(H*1.3),sp:b*.9,r:12,col:'#16a085',k:'r',rew:12,cost:1};
      else
      if(g.wave>=4&&Math.random()<.12*K)z={hp:Math.ceil(H*1.2),sp:b*.95,r:12,col:'#d4572a',k:'b',rew:9,cost:1};   // bomber
      else if(g.wave>=4&&Math.random()<.15*K)z={hp:Math.ceil(H*.9),sp:b*1.1,r:11,col:'#9a86d0',k:'h',hid:true,vis:false,rew:10,cost:1};   // tersembunyi
      else if(g.wave>=3&&r<.2)z={hp:Math.ceil(H*2.8),sp:b*.55,r:15,col:'#5a6a8a',k:'s',rew:11,cost:2};   // lambat & tebal
      else if(g.wave>=2&&r<.5)z={hp:Math.ceil(H*.6),sp:b*1.8,r:9,col:'#e0a030',k:'f',rew:8,cost:1};   // cepat & rapuh
      else z={hp:H,sp:b,r:11,col:'#5f9a4a',k:'n',rew:6,cost:1};
      z.d=0;z.pi=nextPath();z.max=z.hp;z.boss=0;z.hit=0;g.z.push(z)}
  }
  for(const z of g.z){if(z.boss&&!z.rage&&z.hp<z.max/2){z.rage=1;z.sp*=1.5;snd('rage')}if(z.mega&&!z.r2&&z.hp<z.max/4){z.r2=1;z.sp*=1.4;snd('rage')}
    if(z.k==='r'&&z.hp>0&&z.hp<z.max)z.hp=Math.min(z.max,z.hp+z.max*.0007);
    if(z.k==='m'&&z.hp>0&&(z.hc=(z.hc||0)+1)>=150){z.hc=0;for(const o of g.z)if(o.hp>0&&Math.abs(o.d-z.d)<80)o.hp=Math.min(o.max,o.hp+o.max*.12)}
    z.d+=z.sp*slowF(z);if(z.hit>0)z.hit--;if(z.hid){const[hx,hy]=at(z.d,z.pi);z.vis=g.t.concat(g.gen).some(t=>detects(t)&&Math.hypot(hx-t.x,hy-t.y)<=S(t).range[t.lv])}
    if(z.d>=MP.paths[z.pi].tot){z.hp=-999;g.lives-=z.cost;snd('leak');if(g.lives<=0&&!g.over){g.lives=0;lose()}}}
  for(const t of g.t){
    if(t.cd>0)t.cd--;if(t.sw>0)t.sw--;if(t.stun>0){t.stun--;continue}if(t.type==='h')continue;
    if(t.type==='d'){   // Daimyo: panggil prajurit dari garis finish
      if(--t.sm<=0&&g.u.filter(u=>u.o===t&&u.hp>0).length<S(t).cap[t.lv]){t.sm=S(t).rate[t.lv];g.u.push({pi:pathOf(t),d:MP.paths[pathOf(t)].tot-8,o:t,hp:S(t).hp[t.lv],max:S(t).hp[t.lv],dmg:S(t).dmg[t.lv],lv:t.lv,cd:0,sp:1,sw:0,hit:0});snd('summon');t.sw=14}
      else if(t.sm<0)t.sm=0;
      continue;
    }
    if(t.cd<=0){
      let best=null;
      for(const z of g.z){if(z.hp<=0)continue;const[zx,zy]=at(z.d,z.pi);
        if((!z.hid||z.vis)&&Math.hypot(zx-t.x,zy-t.y)<=S(t).range[t.lv]&&(!best||prog(z)>prog(best)))best=z}
      if(best&&t.type==='o'){const[zx,zy]=at(best.d,best.pi);t.ang=Math.atan2(zy-t.y,zx-t.x);t.cd=S(t).rate[t.lv];t.sw=10;const R=S(t).spl[t.lv];for(const z of g.z){if(z.hp<=0||(z.hid&&!z.vis))continue;const[qx,qy]=at(z.d,z.pi);if(Math.hypot(qx-zx,qy-zy)<=R)dmgZ(z,S(t).dmg[t.lv])}g.fx.push({x:zx,y:zy,t:24,r:R});snd('cannon')}else if(best&&t.type==='y'){
        const[zx,zy]=at(best.d,best.pi);t.ang=Math.atan2(zy-t.y,zx-t.x);t.cd=S(t).rate[t.lv];t.sw=8;
        const ca=Math.cos(t.ang),sa=Math.sin(t.ang);
        const L=g.z.filter(z=>{if(z.hp<=0||(z.hid&&!z.vis))return false;const[qx,qy]=at(z.d,z.pi),dx=qx-t.x,dy=qy-t.y,p=dx*ca+dy*sa,q=Math.abs(-dx*sa+dy*ca);return p>0&&p<=S(t).range[t.lv]+z.r&&q<=z.r+7}).sort((a,b)=>prog(b)-prog(a)).slice(0,S(t).hits[t.lv]);
        for(const z of L){dmgZ(z,S(t).dmg[t.lv])}
        snd('stab',t.lv)
      }else if(best&&t.type==='s'){
        const L=g.z.filter(z=>z.hp>0&&(!z.hid||z.vis)&&Math.hypot(at(z.d,z.pi)[0]-t.x,at(z.d,z.pi)[1]-t.y)<=S(t).range[t.lv]).sort((a,b)=>prog(b)-prog(a)).slice(0,S(t).hits[t.lv]);
        const[zx,zy]=at(best.d,best.pi);t.ang=Math.atan2(zy-t.y,zx-t.x);t.cd=S(t).rate[t.lv];t.sw=9;
        for(const z of L){dmgZ(z,S(t).dmg[t.lv])}
        snd('slash',t.lv)
      }else if(best){const[zx,zy]=at(best.d,best.pi);dmgZ(best,S(t).dmg[t.lv]);t.cd=S(t).rate[t.lv];t.ang=Math.atan2(zy-t.y,zx-t.x);
        g.shots.push({x1:t.x,y1:t.y,x2:zx,y2:zy,t:7,a:t.ang,gl:GL[t.lv]+2});snd('shot',t.lv)}
    }
  }
  updateGen();
  for(const u of g.u){   // prajurit Daimyo: jalan dari finish ke depan, berhenti buat bertarung
    if(u.hit>0)u.hit--;if(u.sw>0)u.sw--;
    u.d-=u.sp;for(const z of g.z){if(u.hp<=0)break;if(z.pi!==u.pi||z.hp<=0||(z.hid&&!z.vis)||Math.abs(z.d-u.d)>12)continue;const m=Math.min(u.hp,z.hp);u.hp-=m;z.hp-=m;z.hit=5;u.hit=5;u.sw=8;fxHit(z,m)}
    
    if(u.d<-20)u.hp=0;
  }
  g.u=g.u.filter(u=>u.hp>0);
  if(!g.running&&g.autoT>0&&--g.autoT===0&&auto)startWave();
  if(g.msg&&--g.msg.t<=0)g.msg=null;
  const before=g.z.length;
  g.z=g.z.filter(z=>{if(z.hp<=0){if(z.hp>-999){g.gold+=z.rew;snd('kill');if(z.k==='b')explode(z);if(z.k==='x')for(const sd of[-6,6])g.nz.push({pi:z.pi,d:Math.max(0,z.d+sd),hp:Math.ceil(z.max*.3),max:Math.ceil(z.max*.3),sp:z.sp*1.4,r:7,col:'#e74c3c',k:'n',rew:2,cost:1,boss:0,hit:0})}return false}return true});
  g.z=g.z.concat(g.nz.splice(0));
  g.ps=g.ps.filter(p=>{p.x+=p.vx;p.y+=p.vy;p.vy+=.15;return--p.t>0});g.fl=g.fl.filter(f=>{f.y-=.6;return--f.t>0});g.shots=g.shots.filter(s=>--s.t>0);g.fx=g.fx.filter(f=>--f.t>0);
  if(g.z.length!==before)ui();
  if(g.running&&g.q+g.bs.length===0&&!g.z.length){g.running=false;if(g.wave>=g.dm.w){win();return}g.msg={t:150,a:'GELOMBANG '+g.wave+' SELESAI',b:'Mulai gelombang berikutnya untuk dapat bonus koin',c:'#8bc34a'};if(auto)g.autoT=180;ui()}
  $('gold').textContent=g.gold;$('lives').textContent=g.lives;
}
