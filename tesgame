  x.fillStyle='#ffd54f';for(let i=0;i<l;i++){x.beginPath();x.arc(X-(l-1)*3+i*6,Y+24,2,0,7);x.fill()}
}
function drawKatana(t){
  const l=t.lv,R=ST.s.range[l];
  if(t.sw>0){x.strokeStyle=l>=4?'rgba(255,112,67,'+t.sw/9+')':'rgba(255,255,255,'+t.sw/9+')';x.lineWidth=5+l;x.beginPath();x.arc(t.x,t.y,R*.8,t.ang-1.2,t.ang+1.2);x.stroke()}
  if(l>=4){x.fillStyle='rgba(255,80,40,.18)';x.beginPath();x.arc(t.x,t.y,26,0,7);x.fill()}
  const a=t.ang+(t.sw>0?(t.sw/9-.5)*1.8:0),BL=[0,26,32,38,46][l];
  x.save();x.translate(t.x,t.y);x.rotate(a);
  x.fillStyle='#2a1a12';x.fillRect(4,-2,10,4);
  x.fillStyle='#b3202a';x.fillRect(6,-2,2,4);x.fillRect(10,-2,2,4);
  x.fillStyle='#d4af37';x.fillRect(14,-4,3,8);
  x.fillStyle=['','#ddd','#e6efff','#bfe6ff','#fff'][l];x.fillRect(17,-1.5,BL,3);
  if(l>=3){x.fillStyle=l>=4?'rgba(255,120,60,.6)':'rgba(120,200,255,.5)';x.fillRect(17,-3,BL,6)}
  x.restore();
  drawMask(t);
}
function drawMask(t){
  const l=t.lv,X=t.x,Y=t.y,hy=l>=4?6:0;
  x.fillStyle=l>=4?'#1a1a1a':'#3a3a3a';x.beginPath();x.arc(X,Y-3,12,Math.PI,0);x.fill();x.fillRect(X-14,Y-4,28,3);   // kabuto
  if(l===1){x.fillStyle='#d4af37';x.fillRect(X-1,Y-19,2,7)}
  if(l>=2){x.strokeStyle=l>=3?'#ffd54f':'#d4af37';x.lineWidth=l>=4?3:2;   // tanduk
    for(const sg of[-1,1]){x.beginPath();x.moveTo(X+sg*5,Y-13);x.quadraticCurveTo(X+sg*12,Y-24-hy,X+sg*17,Y-20-hy);x.stroke()}}
  x.fillStyle=['','#c9c2b0','#aab4c0','#8a1e1e','#d02020'][l];   // wajah (menpō)
  x.beginPath();x.moveTo(X-10,Y-3);x.lineTo(X+10,Y-3);x.lineTo(X+7,Y+11);x.lineTo(X-7,Y+11);x.closePath();x.fill();
  x.fillStyle=l>=4?'#ffeb3b':'#111';x.fillRect(X-7,Y,5,2.5);x.fillRect(X+2,Y,5,2.5);
  if(l>=3){x.fillStyle='#fff';for(let i=-1;i<=1;i++){x.beginPath();x.moveTo(X+i*4-1.5,Y+7);x.lineTo(X+i*4+1.5,Y+7);x.lineTo(X+i*4,Y+11);x.fill()}}
  else{x.fillStyle='#222';x.fillRect(X-4,Y+7,8,1.5)}
  x.fillStyle='#ffd54f';for(let i=0;i<l;i++){x.beginPath();x.arc(X-(l-1)*3+i*6,Y+23,2,0,7);x.fill()}
}
function draw(){
  x.setTransform(c.width/W,0,0,c.height/H,0,0);x.fillStyle='#3b4a2f';x.fillRect(0,0,W,H);
  x.lineCap='round';x.lineJoin='round';
  for(const pa of MP.paths){x.strokeStyle='#b99a6b';x.lineWidth=44;x.beginPath();x.moveTo(pa.P[0][0],pa.P[0][1]);for(const p of pa.P)x.lineTo(p[0],p[1]);x.stroke()}
  for(const pa of MP.paths){x.strokeStyle='#d2b88a';x.lineWidth=36;x.beginPath();x.moveTo(pa.P[0][0],pa.P[0][1]);for(const p of pa.P)x.lineTo(p[0],p[1]);x.stroke()}
  for(const pa of MP.paths){const e=pa.P[pa.P.length-1];x.fillStyle='#b3202a';x.fillRect(W-14,e[1]-22,14,44);x.fillStyle='#fff';x.font='bold 11px system-ui,sans-serif';x.textAlign='right';x.fillText('FINISH',W-18,e[1]-28)}
  for(const t of g.t){
    if(t===g.sel||(g.build&&false)){x.fillStyle='rgba(255,255,255,.12)';x.beginPath();x.arc(t.x,t.y,S(t).range[t.lv],0,7);x.fill();x.strokeStyle='#fff8';x.lineWidth=1.5;x.stroke()}
    x.fillStyle=t.type==='s'?['','#7a1f1f','#3a2a5a','#1f4a4a','#111'][t.lv]:t.type==='y'?['','#4a6b3a','#3f7a5a','#2f6a7a','#2a4a8a'][t.lv]:t.type==='d'?['','#5a2a6a','#6a2a7a','#7a2a6a','#8a1a5a'][t.lv]:t.type==='o'?['','#444','#555','#6a4a2a','#8a6a1a'][t.lv]:t.type==='h'?['','#8a6a2a','#9a7a2a','#b08a2a','#d4af37'][t.lv]:['','#6b4a2b','#5a6a7a','#2f3b52','#a8841c'][t.lv];x.beginPath();x.arc(t.x,t.y,t.type==='s'?17:t.type==='d'?18:15,0,7);x.fill();
    if(t.lv>=4){x.strokeStyle='#ffd54f';x.lineWidth=2.5;x.beginPath();x.arc(t.x,t.y,19,0,7);x.stroke()}
    if(t.type==='a'||t.type==='y'){x.fillStyle='#b3202a';x.beginPath();x.arc(t.x,t.y,9,0,7);x.fill()}
    t.type==='s'?drawKatana(t):t.type==='y'?drawYari(t):t.type==='d'?drawDaimyo(t):t.type==='o'?drawCannon(t):t.type==='h'?drawSohei(t):drawGun(t);
    if(t.stun>0){x.fillStyle='rgba(255,235,59,.35)';x.beginPath();x.arc(t.x,t.y,20,0,7);x.fill();x.fillStyle='#fff176';x.font='bold 14px system-ui,sans-serif';x.textAlign='center';x.fillText('⚡',t.x,t.y-22)}
    x.fillStyle='#fff';x.font='bold 10px system-ui,sans-serif';x.textAlign='center';if(t.type==='a'||t.type==='y')x.fillText(t.lv,t.x,t.y+3.5);
  }
  for(const z of g.z){
    const[zx,zy]=at(z.d,z.pi),r=z.r;x.globalAlpha=(z.hid&&!z.vis)?.16:1;
    x.fillStyle=z.hit>0?'#fff':(z.rage?'#c0392b':z.col);x.beginPath();x.arc(zx,zy,r,0,7);x.fill();if(z.k==='s'){x.strokeStyle='#2a3144';x.lineWidth=3;x.stroke()}
    if(z.k==='b'){x.fillStyle='#222';x.fillRect(zx-r*.6,zy+r*.2,r*1.2,3);x.strokeStyle='#222';x.lineWidth=2;x.beginPath();x.moveTo(zx,zy-r);x.lineTo(zx+4,zy-r-7);x.stroke();x.fillStyle=Date.now()%300<150?'#ffeb3b':'#ff5722';x.beginPath();x.arc(zx+4,zy-r-8,3,0,7);x.fill()}
    if(z.k==='a'){x.strokeStyle='#ecf0f1';x.lineWidth=3;x.beginPath();x.arc(zx,zy,r,Math.PI,0);x.stroke()}
    if(z.k==='r'||z.k==='m'){x.fillStyle='#fff';x.fillRect(zx-1.5,zy+2,3,8);x.fillRect(zx-4,zy+4.5,8,3)}
    if(z.k==='x'){x.strokeStyle='#2c0b0b';x.lineWidth=2;x.beginPath();x.moveTo(zx,zy-r);x.lineTo(zx,zy+r);x.stroke()}
    if(z.mega){x.strokeStyle='#ff1744';x.lineWidth=3;x.beginPath();x.arc(zx,zy,r+5,0,7);x.stroke()}
    if(z.k==='h'&&z.vis){x.setLineDash([4,3]);x.strokeStyle='#e0d4ff';x.lineWidth=2;x.stroke();x.setLineDash([])}
    if(z.boss){x.fillStyle='#b3202a';x.beginPath();x.moveTo(zx-r,zy-r*.4);x.lineTo(zx,zy-r*1.5);x.lineTo(zx+r,zy-r*.4);x.fill()}
    x.fillStyle=g.dm.eye;x.beginPath();x.arc(zx-r*.35,zy-r*.1,2,0,7);x.arc(zx+r*.35,zy-r*.1,2,0,7);x.fill();
    x.fillStyle='#000a';x.fillRect(zx-r,zy-r-9,r*2,4);x.fillStyle='#e53935';x.fillRect(zx-r,zy-r-9,r*2*Math.max(0,z.hp)/z.max,4);
  }
  x.globalAlpha=1;
  for(const u of g.u){
    const[ux,uy]=at(Math.max(0,u.d),u.pi),[qx,qy]=at(Math.max(0,u.d-6),u.pi),a=Math.atan2(qy-uy,qx-ux),L=9+(u.lv>=2?5:0)+(u.sw>0?6:0);
    x.strokeStyle=u.lv>=3?'#eee':'#8a5a2a';x.lineWidth=2;x.beginPath();x.moveTo(ux,uy);x.lineTo(ux+Math.cos(a)*L,uy+Math.sin(a)*L);x.stroke();
    x.fillStyle=u.hit>0?'#fff':['','#7d8a6a','#4a8a5a','#a32a2a','#d4af37'][u.lv];x.beginPath();x.arc(ux,uy,7,0,7);x.fill();
    x.fillStyle=u.lv>=3?'#2a2a2a':'#caa86a';x.beginPath();x.moveTo(ux-8,uy-1);x.lineTo(ux,uy-9);x.lineTo(ux+8,uy-1);x.fill();
    x.fillStyle='#000a';x.fillRect(ux-8,uy-14,16,3);x.fillStyle='#4caf50';x.fillRect(ux-8,uy-14,16*Math.max(0,u.hp)/u.max,3);
  }
  drawGeneral();
  for(const p of g.ps){x.globalAlpha=Math.min(1,p.t/12);x.fillStyle=p.c;x.fillRect(p.x-1.5,p.y-1.5,3,3)}
  x.textAlign='center';
  for(const f of g.fl){x.globalAlpha=Math.min(1,f.t/15);x.font='bold '+(f.v>=10?16:13)+'px system-ui,sans-serif';x.lineWidth=3;x.strokeStyle='#000';x.strokeText(f.v,f.x,f.y);x.fillStyle=f.v>=10?'#ffd54f':'#fff';x.fillText(f.v,f.x,f.y)}
  x.globalAlpha=1;
  for(const f of g.fx){x.strokeStyle='rgba(255,140,40,'+f.t/30+')';x.lineWidth=4;x.beginPath();x.arc(f.x,f.y,(f.r||120)*(1-f.t/30)+10,0,7);x.stroke()}
  for(const s of g.shots){
    x.strokeStyle='rgba(255,220,100,'+(s.t/7)+')';x.lineWidth=2;x.beginPath();x.moveTo(s.x1,s.y1);x.lineTo(s.x2,s.y2);x.stroke();
    x.fillStyle='rgba(200,200,200,'+(s.t/10)+')';x.beginPath();x.arc(s.x1+Math.cos(s.a)*s.gl,s.y1+Math.sin(s.a)*s.gl,(8-s.t)*1.6+3,0,7);x.fill();
  }
  if(g.build&&mx>0){
    const ok=valid(mx,my)&&g.gold>=ST[g.build].cost;
    x.fillStyle=ok?'rgba(255,255,255,.15)':'rgba(229,57,53,.2)';x.beginPath();x.arc(mx,my,ST[g.build].range[1],0,7);x.fill();
    x.fillStyle=ok?'#6b4a2b':'#e53935';x.globalAlpha=.7;x.beginPath();x.arc(mx,my,15,0,7);x.fill();x.globalAlpha=1;
  }
  if(g.msg&&!g.over){x.globalAlpha=Math.min(1,g.msg.t/40);x.fillStyle='rgba(0,0,0,.5)';x.fillRect(0,H/2-52,W,86);x.textAlign='center';x.fillStyle=g.msg.c||'#fff';x.font='bold 34px system-ui,sans-serif';x.fillText(g.msg.a,W/2,H/2-8);x.font='16px system-ui,sans-serif';x.fillStyle='#ddd';x.fillText(g.msg.b,W/2,H/2+20);x.globalAlpha=1}
  if(!g.running&&g.autoT>0&&!g.over){x.textAlign='center';x.fillStyle='rgba(0,0,0,.55)';x.fillRect(W/2-160,H/2+50,320,30);x.fillStyle='#ffd54f';x.font='bold 15px system-ui,sans-serif';x.fillText('Gelombang '+(g.wave+1)+' mulai dalam '+Math.ceil(g.autoT/60)+' dtk',W/2,H/2+71)}
  if(g.over){x.fillStyle='#000b';x.fillRect(0,0,W,H);x.fillStyle=g.res.c;x.font='bold 40px system-ui,sans-serif';x.textAlign='center';x.fillText(g.res.a,W/2,H/2-10);x.fillStyle='#fff';x.font='18px system-ui,sans-serif';x.fillText(g.res.b,W/2,H/2+25)}
}
let last=0,acc=0;
function loop(t){acc+=Math.min(t-last,100)*speed;last=t;while(acc>=16.67){if(!g.over&&!paused)update();acc-=16.67}draw();requestAnimationFrame(loop)}
reset();paused=true;renderHome();requestAnimationFrame(loop);
</script>
